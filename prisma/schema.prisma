// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model Account {
  id                String  @id @default(cuid()) @map("_id")
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid()) @map("_id")
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

enum UserRole {
  USER
  COLLEGE_ADMIN
  COLLEGE_STUDENT
  SUPERADMIN
}

model User {
  id            String    @id @default(cuid()) @map("_id")
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  role          UserRole  @default(USER)
  createdAt     DateTime? @default(now())
  updatedAt     DateTime? @updatedAt

  // Profile fields
  firstName     String?
  lastName      String?
  phone         String?
  dateOfBirth   DateTime?
  jobTitle      String?
  company       String?
  location      String?
  bio           String?
  cv            String?

  // Academic fields
  rollNumber      String?
  collegeName     String?
  branch          String?
  course          String?
  courseDuration  String?
  year            String?
  password      String?

  // College Admin fields (for users with COLLEGE_ADMIN role)
  collegeAdminId  String?  // Unique ID for college admin login (e.g., TECH_UNIV_001)
  collegeAdminPassword String?  // Password for college admin login

  // College relationship
  collegeId     String?
  college       College?  @relation(fields: [collegeId], references: [id], onDelete: SetNull)

  // SaaS platform fields
  careerGoals         String?
  linkedIn           String?
  github             String?

  // Time allowances (in minutes)
  totalTimeAllowance   Int      @default(30)  // 30 minutes free for new users
  usedTimeMinutes      Int      @default(0)
  timeAllowanceResetAt DateTime?               

  // Relations
  accounts       Account[]
  sessions       Session[]
  mockInterviews MockInterview[]
  interviewAttempts InterviewAttempt[]
  supportTickets SupportTicket[]
  userProgress   UserProgress[]

  @@map("users")
}

model College {
  id                String    @id @default(cuid()) @map("_id")
  collegeId         String    @unique
  name              String
  description       String?
  location          String?
  website           String?
  phone             String?
  establishedYear   Int?

  // Status and billing (managed by college admins who are users)
  isActive          Boolean   @default(true)
  maxStudents       Int       @default(100)
  currentStudents   Int       @default(0)

  // Billing based on user count
  monthlyRatePerUser Float     @default(150.0) 
  billingCycle       String    @default("monthly")
  nextBillingDate    DateTime?
  lastBillingAmount  Float     @default(0.0)

  // Relations - college admins are now users with COLLEGE_ADMIN role
  users             User[]

  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@map("colleges")
}

model VerificationToken {
  id         String   @id @default(cuid()) @map("_id")
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verificationtokens")
}


enum InterviewStatus {
  IN_PROGRESS
  COMPLETED
}

enum InterviewType {
  GENERAL_INTERVIEW
  TECHNICAL
  CODING
  UI_INTERVIEW
  HR_INTERVIEW
  CUSTOM_INTERVIEW
}

model MockInterview {
  id                String   @id @default(cuid()) @map("_id")
  title             String?
  companyName       String?
  position          String?
  companyDescription String?  @default("")
  jobDescription    String?  @default("")
  cvText            String?  // Optional CV/resume text extracted from uploaded file
  interviewType     InterviewType?
  experienceLevel   String?
  role              String?  // Specific technical role (e.g., 'frontend-developer', 'react-developer')
  attemptCount     Int      @default(0)
  screenShareEnabled Boolean @default(false)
  status            InterviewStatus @default(IN_PROGRESS)
  timeLimitMinutes  Int?     @default(0)
  createdBy         String
  user              User     @relation(fields: [createdBy], references: [id], onDelete: Cascade)
  attempts          InterviewAttempt[]
  prompts           InterviewPrompt[]
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@map("mockinterviews")
}

model InterviewAttempt {
  id                String   @id @default(cuid()) @map("_id")
  startedAt         DateTime @default(now())
  completedAt       DateTime?
  duration          Int?
  status            InterviewStatus @default(IN_PROGRESS)
  interviewId       String
  interview         MockInterview @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  candidateId       String?
  candidate         User?    @relation(fields: [candidateId], references: [id], onDelete: SetNull)
  results           InterviewResult[]
  conversations     InterviewConversation[]
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@map("interviewattempts")
}

model InterviewResult {
  id                String   @id @default(cuid()) @map("_id")
  duration          Int?
  feedback          String?
  knowledge         Float?
  overallScore      Float?
  overallFeedback   String?
  strengths         String[]
  weaknesses        String[]
  recommendations    String[]
  communication     Float?
  notes             String?
  vocabularyComplexity     Float?
  emotionalTone           String?
  wordCountAnalysis       String?
  questionAnsweringQuality Float?
  followUpHandling        Boolean?
  answerStructure         String?
  exampleUsage            Boolean?
  relevantTopicAnswer     Boolean?

  attemptId         String
  attempt           InterviewAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@map("interviewresults")
}

model InterviewPrompt {
  id                String   @id @default(cuid()) @map("_id")
  promptText        String
  isActive          Boolean  @default(true)
  interviewId       String
  interview         MockInterview @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@map("interviewprompts")
}

model InterviewConversation {
  id                String   @id @default(cuid()) @map("_id")
  attemptId         String
  attempt           InterviewAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  transcript        String
  messages          String
  duration          Int
  createdAt         DateTime @default(now())

  @@map("interviewconversations")
}

enum SupportTicketStatus {
  PENDING
  COMPLETED
}

enum SupportTicketPriority {
  LOW
  MEDIUM
  HIGH
}

enum SupportTicketCategory {
  TECHNICAL_ISSUE
  BILLING_PAYMENT
  ACCOUNT_PROFILE
  FEATURE_REQUEST
  GENERAL_INQUIRY
}

model SupportTicket {
  id          String   @id @default(cuid()) @map("_id")
  ticketId    String   @unique // Human-readable ID like "SUP-20240115-001"
  subject     String
  category    SupportTicketCategory
  priority    SupportTicketPriority
  status      SupportTicketStatus @default(PENDING)
  description String

  // For completed tickets
  resolution  String?

  // Relations
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  replies     TicketReply[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("supporttickets")
}

model TicketReply {
  id          String   @id @default(cuid()) @map("_id")
  subject     String
  message     String
  from        String   // "Support Team", "Product Team", etc.

  // Relations
  ticketId    String
  ticket      SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())

  @@map("ticketreplies")
}

// Course/Learning Management Models
enum LessonStatus {
  DEMO
  LOCKED
  COMPLETED
}

enum ExerciseType {
  MCQ
  CODE
}

model Course {
  id          String   @id @default(cuid()) @map("_id")
  title       String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  modules      Module[]
  codeTemplates CodeTemplate[]
  userProgress UserProgress[]

  @@map("courses")
}

model Module {
  id          String   @id @default(cuid()) @map("_id")
  title       String
  courseId    String
  order       Int      @default(0)
  hasDemo     Boolean  @default(false)
  isExpanded  Boolean  @default(false)
  isActive    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  subLessons  SubLesson[]
  exercises   Exercise[]
  userProgress UserProgress[]

  @@map("modules")
}

model SubLesson {
  id          String       @id @default(cuid()) @map("_id")
  title       String
  moduleId    String
  order       Int          @default(0)
  status      LessonStatus @default(LOCKED)
  content     String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  // Relations
  module      Module       @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@map("sublessons")
}

model Exercise {
  id            String        @id @default(cuid()) @map("_id")
  title         String
  moduleId      String
  order         Int           @default(0)
  status        LessonStatus  @default(LOCKED)
  content       String?
  type          ExerciseType?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  // Relations
  module        Module        @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  mcqQuestions  MCQQuestion[]
  codeQuestions CodeQuestion[]

  @@map("exercises")
}

model MCQQuestion {
  id            String   @id @default(cuid()) @map("_id")
  exerciseId    String
  question      String
  options       String[] // Array of option strings
  correctAnswer Int      // Index of correct answer (0-based)
  explanation   String?
  order         Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  exercise      Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)

  @@map("mcqquestions")
}

model CodeQuestion {
  id         String   @id @default(cuid()) @map("_id")
  exerciseId String
  question   String
  solution   String
  order      Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // Relations
  exercise   Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)

  @@map("codequestions")
}

model CodeTemplate {
  id          String   @id @default(cuid()) @map("_id")
  courseId    String
  language    String
  code        String
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([courseId, language])
  @@map("codetemplates")
}

model UserProgress {
  id            String   @id @default(cuid()) @map("_id")
  userId        String
  courseId      String
  moduleId      String
  itemType      String   // "lesson" or "exercise"
  itemKey       String   // Unique key for the item (e.g., "module-1-lesson-1" or "module-1-exercise-1")
  isCompleted   Boolean  @default(false)
  completedAt   DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  course        Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  module        Module   @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@unique([userId, itemKey])
  @@map("userprogress")
}