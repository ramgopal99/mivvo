// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// =============================================================================
// ENUMS
// =============================================================================

enum UserRole {
  USER
  COLLEGE_ADMIN
  COLLEGE_STUDENT
  SUPERADMIN
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum UserType {
  FREE
  PRO
}

enum InterviewStatus {
  IN_PROGRESS
  COMPLETED
}

enum InterviewType {
  GENERAL_INTERVIEW
  TECHNICAL
  CODING
  UI_INTERVIEW
  HR_INTERVIEW
  CUSTOM_INTERVIEW
}

enum SupportTicketStatus {
  PENDING
  COMPLETED
}

enum SupportTicketPriority {
  LOW
  MEDIUM
  HIGH
}

enum SupportTicketCategory {
  TECHNICAL_ISSUE
  BILLING_PAYMENT
  ACCOUNT_PROFILE
  FEATURE_REQUEST
  GENERAL_INQUIRY
}

enum LessonStatus {
  DEMO
  LOCKED
  COMPLETED
}

enum ExerciseType {
  MCQ
  CODE
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  CANCELLED
  REFUNDED
}

enum PaymentCategory {
  MONTHLY
  ADDON
  COURSE_PURCHASE
  SUBSCRIPTION
  CREDITS
  ENTERPRISE
  REFUND
  OTHER
}

// =============================================================================
// MODELS
// =============================================================================

model Account {
  id                String  @id @default(cuid()) @map("_id")
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid()) @map("_id")
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model User {
  id            String     @id @default(cuid()) @map("_id")
  name          String?
  email         String     @unique
  emailVerified DateTime?
  image         String?
  role          UserRole   @default(USER)
  status        UserStatus @default(ACTIVE)
  suspendedAt   DateTime?
  suspendedBy   String?
  suspendReason String?
  createdAt     DateTime?  @default(now())
  updatedAt     DateTime?  @updatedAt

  // Profile fields
  firstName   String?
  lastName    String?
  phone       String?
  dateOfBirth DateTime?
  jobTitle    String?
  company     String?
  location    String?
  bio         String?

  // Academic fields
  rollNumber     String?
  collegeName    String?
  branch         String?
  course         String?
  courseDuration String?
  year           String?
  password       String?

  // User type (free/pro)
  userType UserType @default(FREE)

  // College Admin fields (for users with COLLEGE_ADMIN role)
  collegeAdminId       String? // Unique ID for college admin login (e.g., TECH_UNIV_001)
  collegeAdminPassword String? // Password for college admin login

  // College relationship
  collegeId String?
  college   College? @relation(fields: [collegeId], references: [id], onDelete: SetNull)

  // SaaS platform fields
  careerGoals String?
  linkedIn    String?
  github      String?

  // Foreign Language Learning Preferences
  preferredLanguage String? // User's preferred language (e.g., "ENGLISH", "FRENCH")

  // Credit allocation (in credits)
  totalCreditAllocation Int? // Set by application logic, not database default
  usedCredits           Int       @default(0)
  creditResetAt         DateTime?

  // Relations
  accounts          Account[]
  sessions          Session[]
  mockInterviews    MockInterview[]
  interviewAttempts InterviewAttempt[]
  supportTickets    SupportTicket[]
  userProgress      CourseUserProgress[]
  courseEnrollments CourseEnrollment[]
  courseCredits     CourseCredit[]
  feedback          Feedback[]
  payments          Payment[]
  studentEnrollment StudentEnrollment?

  // Foreign Language Learning Relations
  readingAttempts  ReadingAttempt[]
  mcqAttempts      McqAttempt[]
  speakingAttempts SpeakingAttempt[]
  writingAttempts  WritingAttempt[]
  levelProgress    UserLevelProgress[]

  @@map("users")
}

model College {
  id              String  @id @default(cuid()) @map("_id")
  collegeId       String  @unique
  name            String
  description     String?
  location        String?
  website         String?
  phone           String?
  establishedYear Int?

  // Status and billing (managed by college admins who are users)
  isActive Boolean @default(true)

  // Billing based on user count
  monthlyRatePerUser Float     @default(150.0)
  billingCycle       String    @default("monthly")
  nextBillingDate    DateTime?
  lastBillingAmount  Float     @default(0.0)

  // Relations - college admins are now users with COLLEGE_ADMIN role
  users              User[]
  enterprisePayments EnterprisePayment[]
  studentEnrollments StudentEnrollment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("colleges")
}

model VerificationToken {
  id         String   @id @default(cuid()) @map("_id")
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verificationtokens")
}

model MockInterview {
  id                 String             @id @default(cuid()) @map("_id")
  title              String?
  companyName        String?
  position           String?
  companyDescription String?            @default("")
  jobDescription     String?            @default("")
  cvText             String? // Optional CV/resume text extracted from uploaded file
  interviewType      InterviewType?
  experienceLevel    String?
  role               String? // Specific technical role (e.g., 'frontend-developer', 'react-developer') or HR/foreign language subtype
  attemptCount       Int                @default(0)
  screenShareEnabled Boolean            @default(false)
  status             InterviewStatus    @default(IN_PROGRESS)
  timeLimitMinutes   Int?               @default(0)
  createdBy          String
  user               User               @relation(fields: [createdBy], references: [id], onDelete: Cascade)
  attempts           InterviewAttempt[]
  prompts            InterviewPrompt[]
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  @@map("mockinterviews")
}

model InterviewAttempt {
  id            String                  @id @default(cuid()) @map("_id")
  startedAt     DateTime                @default(now())
  completedAt   DateTime?
  duration      Int?
  status        InterviewStatus         @default(IN_PROGRESS)
  interviewId   String
  interview     MockInterview           @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  candidateId   String?
  candidate     User?                   @relation(fields: [candidateId], references: [id], onDelete: SetNull)
  results       InterviewResult[]
  conversations InterviewConversation[]
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt

  @@map("interviewattempts")
}

model InterviewResult {
  id                       String   @id @default(cuid()) @map("_id")
  duration                 Int?
  feedback                 String?
  knowledge                Float?
  overallScore             Float?
  overallFeedback          String?
  strengths                String[]
  weaknesses               String[]
  recommendations          String[]
  communication            Float?
  notes                    String?
  vocabularyComplexity     Float?
  emotionalTone            String?
  wordCountAnalysis        String?
  questionAnsweringQuality Float?
  followUpHandling         Boolean?
  answerStructure          String?
  exampleUsage             Boolean?
  relevantTopicAnswer      Boolean?

  attemptId String
  attempt   InterviewAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("interviewresults")
}

model InterviewPrompt {
  id          String        @id @default(cuid()) @map("_id")
  promptText  String
  isActive    Boolean       @default(true)
  interviewId String
  interview   MockInterview @relation(fields: [interviewId], references: [id], onDelete: Cascade)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@map("interviewprompts")
}

model InterviewConversation {
  id         String           @id @default(cuid()) @map("_id")
  attemptId  String
  attempt    InterviewAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  transcript String
  messages   String
  duration   Int
  createdAt  DateTime         @default(now())

  @@map("interviewconversations")
}

model SupportTicket {
  id          String                 @id @default(cuid()) @map("_id")
  ticketId    String                 @unique // Human-readable ID like "SUP-20240115-001"
  subject     String
  category    SupportTicketCategory
  priority    SupportTicketPriority?
  status      SupportTicketStatus    @default(PENDING)
  description String

  // For completed tickets
  resolution String?

  // Relations
  userId  String
  user    User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  replies TicketReply[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("supporttickets")
}

model TicketReply {
  id      String @id @default(cuid()) @map("_id")
  subject String
  message String
  from    String // "Support Team", "Product Team", etc.

  // Relations
  ticketId String
  ticket   SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@map("ticketreplies")
}

// Course/Learning Management Models
model Course {
  id          String  @id @default(cuid()) @map("_id")
  title       String
  description String?
  courseId    String  @unique // Unique identifier for course (e.g., 'python', 'java', 'aptitude')
  displayName String // Display name for the course
  price       Float   @default(99.99) // Price in Rupees

  // Course configuration matching test app structure
  headerTitle          String?
  completionPercentage String  @default("0% Completed")

  // Code editor configuration (optional for theory courses)
  monacoLanguage    String?
  codeDisplayName   String?
  defaultCode       String?
  executionLanguage String?
  executionVersion  String?

  // AI Assistant configuration
  aiAssistantName        String?
  aiAssistantDescription String?
  aiAssistantPrompt      String?

  // UI configuration
  showCodeEditor       Boolean @default(false)
  defaultModule        Int     @default(1)
  autoSelectFirstTopic Boolean @default(true)
  showCourseSwitcher   Boolean @default(true)

  // Credit system configuration
  creditEnabled         Boolean @default(false) // Whether credits are required for this course
  defaultCreditAllocation Int? // Default credits allocated to new users for this course
  creditResetType       String @default("MANUAL") // "MANUAL", "DAILY", "MONTHLY", "UNLIMITED"
  creditCostPerAction   Int    @default(1) // Credits consumed per action (e.g., per exercise attempt)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  modules      CourseModule[]
  userProgress CourseUserProgress[]
  enrollments  CourseEnrollment[]
  credits      CourseCredit[]

  @@map("courses")
}

model CourseCredit {
  id            String   @id @default(cuid()) @map("_id")
  userId        String
  courseId      String
  totalCredits  Int      @default(0) // Total credits allocated for this course
  usedCredits   Int      @default(0) // Credits already consumed
  creditType    String   @default("DEFAULT") // Type of credits (e.g., "DAILY", "MONTHLY", "UNLIMITED")
  resetAt       DateTime? // When credits reset (for recurring allocations)
  isActive      Boolean  @default(true) // Whether this credit allocation is active
  lastUsedAt    DateTime? // When credits were last consumed

  // Relations
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, courseId])
  @@map("course_credits")
}

model CourseEnrollment {
  id         String   @id @default(cuid()) @map("_id")
  userId     String
  courseId   String
  enrolledAt DateTime @default(now())
  isActive   Boolean  @default(true)

  // Relations
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [courseId], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, courseId])
  @@map("course_enrollments")
}

model CourseModule {
  id         String   @id @default(cuid()) @map("_id")
  title      String
  courseId   String
  order      Int      @default(0)
  hasDemo    Boolean  @default(true)
  isExpanded Boolean  @default(false)
  isActive   Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // Relations
  course       Course               @relation(fields: [courseId], references: [courseId], onDelete: Cascade)
  topics       CourseTopic[]
  exercises    CourseExercise[]
  formulas     CourseFormula[]
  userProgress CourseUserProgress[]

  @@unique([courseId, order])
  @@map("course_modules")
}

model CourseTopic {
  id             String       @id @default(cuid()) @map("_id")
  title          String
  courseModuleId String
  order          Int          @default(0)
  status         LessonStatus @default(LOCKED)
  content        String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  // Relations
  module CourseModule @relation(fields: [courseModuleId], references: [id], onDelete: Cascade)

  @@map("course_topics")
}

model CourseExercise {
  id             String        @id @default(cuid()) @map("_id")
  title          String
  courseModuleId String
  order          Int           @default(0)
  status         LessonStatus  @default(LOCKED)
  content        String?
  type           ExerciseType?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  // Relations
  module        CourseModule         @relation(fields: [courseModuleId], references: [id], onDelete: Cascade)
  mcqQuestions  CourseMcqQuestion[]
  codeQuestions CourseCodeQuestion[]

  @@map("course_exercises")
}

// Course formulas for aptitude modules
model CourseFormula {
  id             String   @id @default(cuid()) @map("_id")
  courseModuleId String
  formulaId      String // Unique identifier for the formula (e.g., 'module2-quadratic')
  category       String // Category like 'algebra', 'geometry', 'statistics'
  name           String // Display name of the formula
  formula        String // The actual formula expression
  description    String // Description of when to use the formula
  variables      Json? // Array of {symbol: string, description: string} pairs
  order          Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Relations
  module CourseModule @relation(fields: [courseModuleId], references: [id], onDelete: Cascade)

  @@unique([courseModuleId, formulaId])
  @@map("course_formulas")
}

model CourseMcqQuestion {
  id               String   @id @default(cuid()) @map("_id")
  courseExerciseId String
  question         String
  options          String[] // Array of option strings (4 options)
  correctAnswer    Int // Index of correct answer (0-based)
  explanation      String?
  order            Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  // Relations
  exercise CourseExercise @relation(fields: [courseExerciseId], references: [id], onDelete: Cascade)

  @@map("course_mcq_questions")
}

model CourseCodeQuestion {
  id               String   @id @default(cuid()) @map("_id")
  courseExerciseId String
  question         String
  solution         String
  order            Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  // Relations
  exercise CourseExercise @relation(fields: [courseExerciseId], references: [id], onDelete: Cascade)

  @@map("course_code_questions")
}

model CourseUserProgress {
  id             String    @id @default(cuid()) @map("_id")
  userId         String
  courseId       String
  courseModuleId String
  itemType       String // "topic" or "exercise"
  itemKey        String // Unique key for the item (e.g., "module-1-topic-1" or "module-1-exercise-1")
  isCompleted    Boolean   @default(false)
  completedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  // Relations
  user   User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  module CourseModule @relation(fields: [courseModuleId], references: [id], onDelete: Cascade)

  @@unique([userId, itemKey])
  @@map("course_user_progress")
}

// Course attempt tracking for exercises

model Contact {
  id        String        @id @default(cuid()) @map("_id")
  firstName String
  lastName  String
  email     String
  subject   String
  message   String
  ipAddress String? // IP address for spam protection
  status    ContactStatus @default(PENDING)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@map("contacts")
}

enum ContactStatus {
  PENDING
  COMPLETED
}

model Feedback {
  id        String   @id @default(cuid()) @map("_id")
  userId    String
  title     String
  message   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("feedbacks")
}

model Payment {
  id              String          @id @default(cuid()) @map("_id")
  userId          String
  amount          Float
  currency        String          @default("INR")
  paymentCategory PaymentCategory
  status          PaymentStatus   @default(PENDING)
  paymentDate     DateTime
  transactionId   String?
  description     String?
  value           Int? // For addon payments - number of credits or items
  metadata        Json?

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("payments")
}

model EnterprisePayment {
  id             String        @id @default(cuid()) @map("_id")
  collegeId      String
  amount         Float
  currency       String        @default("INR")
  status         PaymentStatus @default(PENDING)
  paymentDate    DateTime
  billingPeriod  String // e.g., "2024-11", "2024-Q4"
  studentCount   Int // Number of students at time of billing
  ratePerStudent Float // Rate per student
  transactionId  String?
  description    String?
  invoiceNumber  String?       @unique
  dueDate        DateTime?
  paidAt         DateTime?
  metadata       Json?

  // Relations
  college College @relation(fields: [collegeId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("enterprise_payments")
}

model StudentEnrollment {
  id               String        @id @default(cuid()) @map("_id")
  collegeId        String
  userId           String        @unique // The created student user account
  rollNumber       String
  enrollmentMonths Int // Number of months (1, 3, 6, 12)
  enrollmentDate   DateTime      @default(now())
  expirationDate   DateTime
  paymentAmount    Float
  paymentStatus    PaymentStatus @default(PENDING)
  paymentId        String? // Reference to Payment model
  isActive         Boolean       @default(true)

  // Relations
  college College @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("student_enrollments")
}

// =============================================================================
// FOREIGN LANGUAGE LEARNING SYSTEM - READING
// =============================================================================

enum CEFRLevel {
  A1
  A2
  B1
  B2
  C1
  C2
}

enum SkillType {
  READING
  WRITING
  SPEAKING
  MCQ
}

enum ReadingSessionType {
  READING_COMPREHENSION
  REARRANGE_SENTENCES
}

enum AttemptStatus {
  IN_PROGRESS
  COMPLETED
  ABANDONED
}

enum McqSessionType {
  VOCABULARY
  GRAMMAR
  ERROR_DETECTION
  SYNONYMS_ANTONYMS
  SENTENCE_COMPLETION
  WORD_REPLACEMENT
  MIXED
}

enum McqQuestionCategory {
  GRAMMAR
  VOCABULARY
  ERROR_DETECTION
  SYNONYMS_ANTONYMS
  SENTENCE_COMPLETION
  WORD_REPLACEMENT
}

enum SpeakingSessionType {
  LISTEN_SPEAK
  LISTEN_REPEAT
  MIXED
}

enum SpeakingQuestionCategory {
  LISTEN_SPEAK
  LISTEN_REPEAT
}

// Language configuration - configurable languages
model LanguageConfig {
  id        String   @id @default(cuid()) @map("_id")
  language  String   @unique // "ENGLISH", "FRENCH", etc.
  name      String // "English", "French"
  code      String // "en", "fr"
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  skills            SkillConfig[]
  readingSessions   ReadingSession[]
  mcqSessions       McqSession[]
  speakingSessions  SpeakingSession[]
  writingSessions   WritingSession[]
  userLevelProgress UserLevelProgress[]
  readingAttempts   ReadingAttempt[]
  mcqAttempts       McqAttempt[]
  speakingAttempts  SpeakingAttempt[]
  writingAttempts   WritingAttempt[]

  @@map("language_configs")
}

// Skill configuration
model SkillConfig {
  id          String    @id @default(cuid()) @map("_id")
  skill       SkillType
  name        String // "Reading", "Writing", etc.
  description String
  weight      Float     @default(0.25) // 25% contribution to level
  isActive    Boolean   @default(true)
  languageId  String

  // Relations
  language LanguageConfig @relation(fields: [languageId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([skill, languageId])
  @@map("skill_configs")
}

// Reading practice sessions
model ReadingSession {
  id          String             @id @default(cuid()) @map("_id")
  title       String
  sessionType ReadingSessionType
  languageId  String
  cefrLevel   String // CEFR level (e.g., "A1", "A2", etc.)
  timeLimit   Int? // Time limit in minutes
  isActive    Boolean            @default(true)

  // Relations
  language          LanguageConfig         @relation(fields: [languageId], references: [id], onDelete: Cascade)
  comprehensionData ReadingComprehension[]
  rearrangingData   ReadingRearrange[]
  attempts          ReadingAttempt[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("reading_sessions")
}

// Reading comprehension questions
model ReadingComprehension {
  id            String   @id @default(cuid()) @map("_id")
  sessionId     String
  passage       String
  question      String
  options       String[] // Array of 4 options
  correctAnswer Int // Index of correct answer (0-3)
  explanation   String
  order         Int // Question order in session

  // Relations
  session ReadingSession               @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  results ReadingComprehensionResult[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([sessionId, order])
  @@map("reading_comprehensions")
}

// Reading sentence rearrangement tasks
model ReadingRearrange {
  id             String   @id @default(cuid()) @map("_id")
  sessionId      String
  scrambledWords String[] // Array of scrambled words
  correctOrder   String[] // Array of words in correct order
  explanation    String
  order          Int // Task order in session

  // Relations
  session ReadingSession           @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  results ReadingRearrangeResult[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([sessionId, order])
  @@map("reading_rearranges")
}

// User's reading attempts
model ReadingAttempt {
  id          String        @id @default(cuid()) @map("_id")
  userId      String
  sessionId   String
  languageId  String // Language for this attempt (redundant but for performance)
  status      AttemptStatus @default(IN_PROGRESS)
  startedAt   DateTime      @default(now())
  completedAt DateTime?
  duration    Int? // Duration in seconds

  // Relations
  user                 User                         @relation(fields: [userId], references: [id], onDelete: Cascade)
  session              ReadingSession               @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  language             LanguageConfig               @relation(fields: [languageId], references: [id], onDelete: Cascade)
  comprehensionResults ReadingComprehensionResult[]
  rearrangingResults   ReadingRearrangeResult[]
  overallResult        ReadingOverallResult?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, sessionId, startedAt]) // Prevent duplicate attempts
  @@map("reading_attempts")
}

// Results for comprehension questions
model ReadingComprehensionResult {
  id         String  @id @default(cuid()) @map("_id")
  attemptId  String
  questionId String
  userAnswer Int // User's selected answer (0-3)
  isCorrect  Boolean
  timeSpent  Int // Time spent on this question in seconds

  // Relations
  attempt  ReadingAttempt       @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question ReadingComprehension @relation(fields: [questionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([attemptId, questionId])
  @@map("reading_comprehension_results")
}

// Results for rearrangement tasks
model ReadingRearrangeResult {
  id         String   @id @default(cuid()) @map("_id")
  attemptId  String
  taskId     String
  userAnswer String[] // User's arranged words
  isCorrect  Boolean
  timeSpent  Int // Time spent on this task in seconds

  // Relations
  attempt ReadingAttempt   @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  task    ReadingRearrange @relation(fields: [taskId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([attemptId, taskId])
  @@map("reading_rearrange_results")
}

// Overall result for reading attempt
model ReadingOverallResult {
  id                 String   @id @default(cuid()) @map("_id")
  attemptId          String   @unique
  overallScore       Int // Overall score (0-100)
  comprehensionScore Int // Comprehension score (0-100)
  rearrangingScore   Int // Rearranging score (0-100)
  feedback           String
  overallFeedback    String
  strengths          String[] // Array of strengths
  weaknesses         String[] // Array of weaknesses
  recommendations    String[] // Array of recommendations
  timeSpent          Json // { comprehension: number, rearranging: number }

  // Relations
  attempt ReadingAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("reading_overall_results")
}

// MCQ Session
model McqSession {
  id          String         @id @default(cuid()) @map("_id")
  title       String
  sessionType McqSessionType
  languageId  String
  cefrLevel   String // CEFR level (e.g., "A1", "A2", etc.)
  timeLimit   Int? // Time limit in minutes
  isActive    Boolean        @default(true)

  // Relations
  language  LanguageConfig @relation(fields: [languageId], references: [id], onDelete: Cascade)
  questions McqQuestion[]
  attempts  McqAttempt[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("mcq_sessions")
}

// MCQ questions
model McqQuestion {
  id            String              @id @default(cuid()) @map("_id")
  sessionId     String
  question      String
  options       String[] // Array of 4 options
  correctAnswer Int // Index of correct answer (0-3)
  explanation   String
  category      McqQuestionCategory
  order         Int // Question order in session

  // Relations
  session McqSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  results McqResult[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([sessionId, order])
  @@map("mcq_questions")
}

// User's MCQ attempts
model McqAttempt {
  id          String        @id @default(cuid()) @map("_id")
  userId      String
  sessionId   String
  languageId  String // Language for this attempt (redundant but for performance)
  status      AttemptStatus @default(IN_PROGRESS)
  startedAt   DateTime      @default(now())
  completedAt DateTime?
  duration    Int? // Duration in seconds

  // Relations
  user          User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  session       McqSession        @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  language      LanguageConfig    @relation(fields: [languageId], references: [id], onDelete: Cascade)
  results       McqResult[]
  overallResult McqOverallResult?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, sessionId, startedAt]) // Prevent duplicate attempts
  @@map("mcq_attempts")
}

// Results for MCQ questions
model McqResult {
  id         String  @id @default(cuid()) @map("_id")
  attemptId  String
  questionId String
  userAnswer Int? // User's selected answer (0-3), null if not answered
  isCorrect  Boolean
  timeSpent  Int // Time spent on this question in seconds

  // Relations
  attempt  McqAttempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question McqQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([attemptId, questionId])
  @@map("mcq_results")
}

// Overall result for MCQ attempt
model McqOverallResult {
  id                 String   @id @default(cuid()) @map("_id")
  attemptId          String   @unique
  overallScore       Int // Overall score (0-100)
  totalQuestions     Int // Total number of questions
  correctAnswers     Int // Number of correct answers
  accuracyPercentage Int // Accuracy percentage (0-100)
  feedback           String
  overallFeedback    String
  strengths          String[] // Array of strengths
  weaknesses         String[] // Array of weaknesses
  recommendations    String[] // Array of recommendations
  timeSpent          Int // Total time spent in seconds

  // Relations
  attempt McqAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("mcq_overall_results")
}

