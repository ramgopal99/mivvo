// Speaking session
model SpeakingSession {
  id             String              @id @default(cuid()) @map("_id")
  title          String
  sessionType    SpeakingSessionType
  languageId     String
  cefrLevel      String // CEFR level (e.g., "A1", "A2", etc.)
  timeLimit      Int? // Time limit in minutes per question
  totalTimeLimit Int? // Total time limit in minutes for entire session
  isActive       Boolean             @default(true)

  // Relations
  language  LanguageConfig     @relation(fields: [languageId], references: [id], onDelete: Cascade)
  questions SpeakingQuestion[]
  attempts  SpeakingAttempt[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("speaking_sessions")
}

// Speaking questions
model SpeakingQuestion {
  id        String                   @id @default(cuid()) @map("_id")
  sessionId String
  question  String
  category  SpeakingQuestionCategory
  order     Int // Question order in session

  // Relations
  session SpeakingSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  results SpeakingResult[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([sessionId, order])
  @@map("speaking_questions")
}

// Speaking attempt
model SpeakingAttempt {
  id          String        @id @default(cuid()) @map("_id")
  userId      String
  sessionId   String
  languageId  String // Language for this attempt (redundant but for performance)
  status      AttemptStatus @default(IN_PROGRESS)
  startedAt   DateTime      @default(now())
  completedAt DateTime?
  duration    Int? // Duration in seconds

  // Relations
  user          User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  session       SpeakingSession        @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  language      LanguageConfig         @relation(fields: [languageId], references: [id], onDelete: Cascade)
  results       SpeakingResult[]
  overallResult SpeakingOverallResult?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, sessionId, startedAt]) // Prevent duplicate attempts
  @@map("speaking_attempts")
}

// Speaking result for individual questions
model SpeakingResult {
  id            String @id @default(cuid()) @map("_id")
  attemptId     String
  questionId    String
  userAnswer    String // User's spoken answer (transcription)
  wordCount     Int // Word count of the answer
  timeSpent     Int // Time spent speaking in seconds
  audioDuration Float? // Duration of the audio recording in seconds
  confidence    Float? // Speech recognition confidence (0-1)

  // Relations
  attempt  SpeakingAttempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question SpeakingQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([attemptId, questionId])
  @@map("speaking_results")
}

// Overall result for speaking attempt
model SpeakingOverallResult {
  id                   String   @id @default(cuid()) @map("_id")
  attemptId            String   @unique
  fluencyScore         Int // Fluency score (0-100)
  pronunciationScore   Int // Pronunciation score (0-100)
  vocabularyScore      Int // Vocabulary score (0-100)
  grammarScore         Int // Grammar score (0-100)
  overallScore         Int // Overall score (0-100)
  feedback             String
  overallFeedback      String
  strengths            String[] // Array of strengths
  weaknesses           String[] // Array of weaknesses
  recommendations      String[] // Array of recommendations
  totalWords           Int // Total words spoken
  averageAudioDuration Float // Average audio duration per response
  timeSpent            Int // Total time spent in seconds

  // Relations
  attempt SpeakingAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("speaking_overall_results")
}

// User's level progress tracking
model UserLevelProgress {
  id                  String    @id @default(cuid()) @map("_id")
  userId              String
  languageId          String // Language for this progress tracking
  cefrLevel           String // CEFR level (e.g., "A1", "A2", etc.)
  skillType           SkillType
  currentAverageScore Float     @default(0) // Average score across all attempts
  requiredTargetScore Int // Target score for this skill in this level
  attemptsCount       Int       @default(0) // Number of attempts made
  isCompleted         Boolean   @default(false) // Whether this skill is completed for the level
  completedAt         DateTime?
  lastAttemptAt       DateTime?

  // Relations
  user     User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  language LanguageConfig @relation(fields: [languageId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, languageId, cefrLevel, skillType])
  @@map("user_level_progress")
}

enum WritingSessionType {
  WRITING_COMPREHENSIVE
}

// Writing Session
model WritingSession {
  id          String             @id @default(cuid()) @map("_id")
  title       String
  sessionType WritingSessionType
  languageId  String
  cefrLevel   String // CEFR level (e.g., "A1", "A2", etc.)
  timeLimit   Int? // Time limit in minutes
  isActive    Boolean            @default(true)

  // Relations
  language      LanguageConfig        @relation(fields: [languageId], references: [id], onDelete: Cascade)
  topics        WritingTopic[]
  chatScenarios WritingChatScenario[]
  attempts      WritingAttempt[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("writing_sessions")
}

// Writing topics for practice
model WritingTopic {
  id           String @id @default(cuid()) @map("_id")
  sessionId    String
  topic        String
  description  String
  instructions String
  wordLimit    Int?
  order        Int // Topic order in session

  // Relations
  session WritingSession       @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  results WritingTopicResult[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([sessionId, order])
  @@map("writing_topics")
}

// Writing chat scenarios
model WritingChatScenario {
  id             String   @id @default(cuid()) @map("_id")
  sessionId      String
  title          String
  description    String
  initialMessage String
  vocabulary     String[] // Array of relevant vocabulary words
  context        String? // Context for the conversation
  order          Int // Scenario order in session

  // Relations
  session WritingSession      @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  results WritingChatResult[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([sessionId, order])
  @@map("writing_chat_scenarios")
}

// Writing Attempt
model WritingAttempt {
  id          String        @id @default(cuid()) @map("_id")
  userId      String
  sessionId   String
  languageId  String // Language for this attempt (redundant but for performance)
  status      AttemptStatus @default(IN_PROGRESS)
  startedAt   DateTime      @default(now())
  completedAt DateTime?
  duration    Int? // Duration in seconds

  // Relations
  user          User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  session       WritingSession        @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  language      LanguageConfig        @relation(fields: [languageId], references: [id], onDelete: Cascade)
  topicResults  WritingTopicResult[]
  chatResults   WritingChatResult[]
  overallResult WritingOverallResult?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, sessionId, startedAt]) // Prevent duplicate attempts
  @@map("writing_attempts")
}

// Results for writing topics
model WritingTopicResult {
  id         String @id @default(cuid()) @map("_id")
  attemptId  String
  topicId    String
  userAnswer String // User's written response
  wordCount  Int? // Word count of the response
  timeSpent  Int // Time spent on this topic in seconds

  // Relations
  attempt WritingAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  topic   WritingTopic   @relation(fields: [topicId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([attemptId, topicId])
  @@map("writing_topic_results")
}

// Results for chat conversations
model WritingChatResult {
  id           String @id @default(cuid()) @map("_id")
  attemptId    String
  scenarioId   String
  conversation Json // Array of {sender: 'user'|'ai', message: string, timestamp: Date}
  messageCount Int // Number of messages in conversation
  timeSpent    Int // Time spent on this chat in seconds

  // Relations
  attempt  WritingAttempt      @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  scenario WritingChatScenario @relation(fields: [scenarioId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([attemptId, scenarioId])
  @@map("writing_chat_results")
}

// Overall result for writing attempt
model WritingOverallResult {
  id                  String   @id @default(cuid()) @map("_id")
  attemptId           String   @unique
  overallScore        Int // Overall score (0-100)
  topicWritingScore   Int? // Writing topics score (0-100)
  aiConversationScore Int? // AI conversation score (0-100)
  feedback            String
  overallFeedback     String
  strengths           String[] // Array of strengths
  weaknesses          String[] // Array of weaknesses
  recommendations     String[] // Array of recommendations
  timeSpent           Json // { topics: number, chat: number }
  creativityScore     Int? // Creativity score (0-100)
  grammarAccuracy     Int? // Grammar accuracy score (0-100)
  vocabularyUsage     Int? // Vocabulary usage score (0-100)
  conversationFlow    Int? // Conversation flow score (0-100)
  topicCoverage       Int? // Topic coverage score (0-100)
  responseLength      Int? // Response length score (0-100)

  // Relations
  attempt WritingAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("writing_overall_results")
}

